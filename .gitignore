# Build and install output
node_modules/
.test-output/
*.tsbuildinfo

# Local deck builds: the plugin writes decks under the session workspace, and a
# checkout should never carry one into a commit.
deck/
*.pdf
*.pdfpc

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local environment
.env
.env.*
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Timestamped backups written by maintenance scripts, e.g.
# `cordis.patch.yml.bak-20261014-133757`. A bare `*.bak-*` pattern does not match
# these: the suffix follows a second extension, so the stem is `cordis.patch.yml`.
*.bak
*.bak-*
*.bak.*
